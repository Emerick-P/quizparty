# Copie ce fichier en .env et remplis-le. Ne jamais versionner le fichier .env.

# Identifiants d'une application Twitch (https://dev.twitch.tv/console/apps), pour l'API IGDB.
# Sans eux, les modes « Jaquette » sont grisés (sauf si des jaquettes sont déjà en cache).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Clé de l'API Steam Web (https://steamcommunity.com/dev/apikey), pour le jeu « Ta bande ».
# Sans elle, les joueurs ne peuvent pas lier leur profil Steam et « Ta bande » reste grisé.
STEAM_API_KEY=

# Port du serveur (3000 par défaut)
# PORT=3000

# --- En ligne seulement (le script deploy/install.sh les remplit) ---
# Node n'écoute que sur la machine : Caddy (HTTPS) est la seule porte d'entrée.
# HOST=127.0.0.1
# Le serveur est derrière Caddy : IP réelle des joueurs et cookies « secure ».
# TRUST_PROXY=1

# --- Soumissions des amis et signalements ⚑ (Supabase, gratuit) ---
# Supabase → Project Settings → API Keys : « Project URL » et une clé secrète (sb_secret_…).
# Sans elles, tout est enregistré en local dans data/submissions/ (pratique sur le PC).
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=

# --- Quiz en direct (server/live.js) : réglages facultatifs ---
# Créneaux (heure de Paris), par défaut 12:45 / 18:30 / 22:00 en semaine, 11:00 / 18:30 / 22:00 le samedi,
# 11:00 / 18:30 / 21:00 (finale) le dimanche. Formats : midi, brunch, soir, nuit, finale.
# LIVE_SLOTS={"week":[["12:45","midi"],["18:30","soir"],["22:00","nuit"]]}
# Ouverture de la salle d'attente avant le départ, en ms (5 min par défaut)
# LIVE_OPEN_MS=300000
# Render remplit RENDER_EXTERNAL_URL tout seul : le serveur s'en sert pour rester éveillé pendant un direct.
